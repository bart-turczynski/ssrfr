# R build/dev artifacts
^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^.*\.Rcheck$
^.*\.tar\.gz$
^\.lintr$
^air\.toml$
^_pkgdown\.yml$
^site$
^public$
^\.r-lib$
^\.pak-cache$
^cran-comments\.md$
^CRAN-SUBMISSION$
^doc$
^Meta$
# Shared scaffold layer: everything below is dev tooling, not package content,
# and would otherwise trip "non-standard files/directories" in R CMD check.
^\.github$
^\.git$
^\.gitlab-ci\.yml$
^renovate\.json$
^\.editorconfig$
^\.env$
^\.env\.example$
^\.gitattributes$
^\.gitignore$
^\.pre-commit-config\.yaml$
^\.fp$
^\.claude$
^_scratch$
^docs$
^design$
^scripts$
^ARCHITECTURE\.md$
^CLAUDE\.md$
^AGENTS\.md$
^AGENTS_LANG\.md$
^CONTRIBUTING\.md$
^SECURITY\.md$
^CHANGELOG\.md$
^\.DS_Store$
