# R build/dev artifacts
^.*\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.Ruserdata$
^.*\.Rcheck$
^.*\.tar\.gz$
^\.lintr$
^air\.toml$
^_pkgdown\.yml$
^site$
^public$
^\.r-lib$
^\.pak-cache$
^cran-comments\.md$
^CRAN-SUBMISSION$
^doc$
^Meta$
# Shared scaffold layer: everything below is dev tooling, not package content,
# and would otherwise trip "non-standard files/directories" in R CMD check.
^\.github$
^\.git$
^\.gitlab-ci\.yml$
^renovate\.json$
^\.editorconfig$
^\.env$
^\.env\.example$
^\.gitattributes$
^\.gitignore$
^\.pre-commit-config\.yaml$
^\.fp$
^\.claude$
^_scratch$
# Logs and build output. R CMD build ignores .gitignore, so without this a
# local build sweeps tmp/ into the tarball (SEOR-jlwnvzoq).
^tmp$
^tests/testthat/_problems$
^docs$
^design$
^scripts$
^ARCHITECTURE\.md$
^CLAUDE\.md$
^AGENTS\.md$
^AGENTS_LANG\.md$
^CONTRIBUTING\.md$
^SECURITY\.md$
^\.DS_Store$
# Publication, citation and policy metadata: served from the repository, not
# part of the installable package. inst/CITATION is NOT listed, so it ships.
# LICENSE.md is the full MIT text for the forge license detector; the tarball
# needs only the two-line LICENSE stub.
^LICENSE\.md$
^README\.Rmd$
^codemeta\.json$
^CITATION\.cff$
^\.zenodo\.json$
^SECURITY-INSIGHTS\.yml$
^\.bestpractices\.json$
^\.fossa\.yml$
^\.cache$
^CODE_OF_CONDUCT\.md$
^\.gitlab$
